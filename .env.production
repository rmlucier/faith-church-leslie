# Canonical site origin, substituted into index.html (%VITE_SITE_URL%) at build
# and read by SEO.jsx at runtime. No trailing slash.
# After the GoDaddy DNS cutover, change this to https://faithchurchleslie.com
# and redeploy so canonical/OG/JSON-LD URLs point at the real domain.
VITE_SITE_URL=https://faith-church-leslie.vercel.app
